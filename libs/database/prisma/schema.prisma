datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  OPERATOR
  ACCOUNTANT
  VIEWER
}

enum FiscalEnvironment {
  HOMOLOGATION
  PRODUCTION
}

enum TaxRegime {
  SIMPLES_NACIONAL
  SIMPLES_EXCESSO
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum DocumentType {
  NFE
  NFCE
  NFSE
}

enum DocumentStatus {
  DRAFT
  VALIDATED
  QUEUED
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
  DENIED
}

enum OperationType {
  INBOUND
  OUTBOUND
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members             OrganizationMember[]
  apiKeys             ApiKey[]
  companies           Company[]
  customers           Customer[]
  products            Product[]
  fiscalDocuments     FiscalDocument[]
  webhookSubscriptions WebhookSubscription[]
  auditLogs           AuditLog[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships OrganizationMember[]
  auditLogs   AuditLog[]

  @@map("users")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           UserRole     @default(OPERATOR)
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  keyPrefix      String    @map("key_prefix")
  keyHash        String    @map("key_hash")
  scopes         String[]  @default(["*"])
  isActive       Boolean   @default(true) @map("is_active")
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model Company {
  id                    String            @id @default(uuid())
  organizationId        String            @map("organization_id")
  legalName             String            @map("legal_name")
  tradeName             String            @map("trade_name")
  cnpj                  String
  stateRegistration     String?           @map("state_registration")
  municipalRegistration String?           @map("municipal_registration")
  cnae                  String?
  taxRegime             TaxRegime         @default(SIMPLES_NACIONAL) @map("tax_regime")
  environment           FiscalEnvironment @default(HOMOLOGATION)
  
  // Address
  street        String
  number        String
  complement    String?
  neighborhood  String
  cityCode      String  @map("city_code")
  cityName      String  @map("city_name")
  state         String  @db.VarChar(2)
  zipCode       String  @map("zip_code")
  
  // Contacts
  email         String
  phone         String?
  
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  certificates    CompanyCertificate[]
  providerConfigs CompanyProviderConfig[]
  fiscalDocuments FiscalDocument[]

  @@unique([organizationId, cnpj])
  @@index([organizationId])
  @@map("companies")
}

model CompanyCertificate {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  companyId         String    @map("company_id")
  encryptedData     String    @map("encrypted_data")
  encryptionIv      String    @map("encryption_iv")
  encryptionAuthTag String    @map("encryption_auth_tag")
  validFrom         DateTime  @map("valid_from")
  validTo           DateTime  @map("valid_to")
  issuer            String
  subjectCnpj       String    @map("subject_cnpj")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([companyId])
  @@map("company_certificates")
}

model CompanyProviderConfig {
  id                   String            @id @default(uuid())
  organizationId       String            @map("organization_id")
  companyId            String            @map("company_id")
  providerKey          String            @map("provider_key")
  environment          FiscalEnvironment @default(HOMOLOGATION)
  encryptedCredentials String            @map("encrypted_credentials")
  isActive             Boolean           @default(true) @map("is_active")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, providerKey, environment])
  @@index([organizationId])
  @@index([companyId])
  @@map("company_provider_configs")
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  documentType   String   @map("document_type") // CPF | CNPJ
  documentNumber String   @map("document_number")
  name           String
  email          String?
  phone          String?
  ie             String?
  ieIndicator    String   @default("9") @map("ie_indicator") // 1=Contribuinte, 2=Isento, 9=Não Contribuinte
  
  street         String
  number         String
  complement     String?
  neighborhood   String
  cityCode       String   @map("city_code")
  cityName       String   @map("city_name")
  state          String   @db.VarChar(2)
  zipCode        String   @map("zip_code")
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalDocuments FiscalDocument[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId])
  @@map("customers")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  description    String
  ncm            String
  cest           String?
  cfopDefault    String   @map("cfop_default")
  unit           String
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 4)
  origin         String   @default("0")
  cstIcms        String?  @map("cst_icms")
  csosn          String?  @map("csosn")
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("products")
}

model FiscalDocument {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  companyId      String         @map("company_id")
  customerId     String?        @map("customer_id")
  
  documentType   DocumentType   @default(NFE) @map("document_type")
  status         DocumentStatus @default(DRAFT)
  environment    FiscalEnvironment @default(HOMOLOGATION)
  
  series         Int            @default(1)
  number         Int?
  accessKey      String?        @map("access_key") @db.VarChar(44)
  protocolNumber String?        @map("protocol_number")
  authorizedAt   DateTime?      @map("authorized_at")
  
  operationNature String        @default("VENDA DE MERCADORIA") @map("operation_nature")
  operationType   OperationType @default(OUTBOUND) @map("operation_type")
  
  // Totals
  totalProducts Decimal @default(0) @map("total_products") @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @map("total_discount") @db.Decimal(12, 2)
  totalIcms     Decimal @default(0) @map("total_icms") @db.Decimal(12, 2)
  totalIpi      Decimal @default(0) @map("total_ipi") @db.Decimal(12, 2)
  totalPis      Decimal @default(0) @map("total_pis") @db.Decimal(12, 2)
  totalCofins   Decimal @default(0) @map("total_cofins") @db.Decimal(12, 2)
  totalShipping Decimal @default(0) @map("total_shipping") @db.Decimal(12, 2)
  totalDocument Decimal @default(0) @map("total_document") @db.Decimal(12, 2)
  
  // Provider Reference
  providerKey       String? @map("provider_key")
  externalReference String? @map("external_reference")
  externalId        String? @map("external_id")
  
  // Files and Errors
  xmlContent      String?   @map("xml_content") @db.Text
  xmlUrl          String?   @map("xml_url")
  pdfUrl          String?   @map("pdf_url")
  rejectionCode   String?   @map("rejection_code")
  rejectionReason String?   @map("rejection_reason")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        FiscalDocumentItem[]
  events       FiscalDocumentEvent[]
  submissions  FiscalSubmission[]

  @@unique([companyId, documentType, series, number])
  @@index([organizationId])
  @@index([companyId])
  @@index([accessKey])
  @@index([status])
  @@map("fiscal_documents")
}

model FiscalDocumentItem {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  documentId     String   @map("document_id")
  itemOrder      Int      @map("item_order")
  
  code        String
  description String
  ncm         String
  cfop        String
  unit        String
  quantity    Decimal @db.Decimal(12, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 4)
  totalPrice  Decimal @map("total_price") @db.Decimal(12, 2)
  
  icmsCst     String? @map("icms_cst")
  icmsBase    Decimal @default(0) @map("icms_base") @db.Decimal(12, 2)
  icmsRate    Decimal @default(0) @map("icms_rate") @db.Decimal(5, 2)
  icmsValue   Decimal @default(0) @map("icms_value") @db.Decimal(12, 2)
  
  pisValue    Decimal @default(0) @map("pis_value") @db.Decimal(12, 2)
  cofinsValue Decimal @default(0) @map("cofins_value") @db.Decimal(12, 2)

  document FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
  @@map("fiscal_document_items")
}

model FiscalDocumentEvent {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  documentId       String   @map("document_id")
  eventType        String   @map("event_type")
  description      String
  externalProtocol String?  @map("external_protocol")
  payload          Json?
  createdAt        DateTime @default(now()) @map("created_at")

  document FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
  @@map("fiscal_document_events")
}

model FiscalSubmission {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  documentId     String         @map("document_id")
  idempotencyKey String         @unique @map("idempotency_key")
  providerKey    String         @map("provider_key")
  attemptCount   Int            @default(1) @map("attempt_count")
  status         DocumentStatus @default(QUEUED)
  lastError      String?        @map("last_error")
  requestPayload Json?          @map("request_payload")
  responsePayload Json?         @map("response_payload")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  document FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
  @@map("fiscal_submissions")
}

model WebhookSubscription {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  targetUrl      String   @map("target_url")
  secretKey      String   @map("secret_key")
  events         String[]
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("webhook_subscriptions")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  details        Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@map("audit_logs")
}


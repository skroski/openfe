# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_URL=http://localhost:4200

# Database (PostgreSQL)
DATABASE_URL=postgresql://opennfe:opennfe_secret@localhost:5432/opennfe_db?schema=public
POSTGRES_USER=opennfe
POSTGRES_PASSWORD=opennfe_secret
POSTGRES_DB=opennfe_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Secrets
JWT_SECRET=opennfe-super-secret-jwt-key-change-in-production-min32chars
JWT_EXPIRES_IN=7d
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Focus NFe (Adapter Credentials for test/dev)
FOCUS_NFE_ENV=homologacao
FOCUS_NFE_TOKEN_TEST=

